{
  "name": "@traceflow/sdk",
  "version": "0.1.0",
  "main": "dist/trace-sdk.cjs.js",
  "types": "dist/index.d.ts",
  "module": "dist/trace-sdk.es.js",
  "unpkg": "dist/trace-sdk.iife.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/trace-sdk.es.js",
      "require": "./dist/trace-sdk.cjs.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/trace-sdk.cjs.js"
    },
    "./web": {
      "import": "./dist/trace-sdk.web.es.js",
      "require": "./dist/trace-sdk.web.cjs.js",
      "default": "./dist/trace-sdk.web.iife.js"
    },
    "./weixin": {
      "import": "./dist/trace-sdk.weixin.es.js",
      "require": "./dist/trace-sdk.weixin.cjs.js"
    },
    "./alipay": {
      "import": "./dist/trace-sdk.alipay.es.js",
      "require": "./dist/trace-sdk.alipay.cjs.js"
    },
    "./baidu": {
      "import": "./dist/trace-sdk.baidu.es.js",
      "require": "./dist/trace-sdk.baidu.cjs.js"
    },
    "./toutiao": {
      "import": "./dist/trace-sdk.toutiao.es.js",
      "require": "./dist/trace-sdk.toutiao.cjs.js"
    },
    "./nodejs": {
      "import": "./dist/trace-sdk.nodejs.es.js",
      "require": "./dist/trace-sdk.nodejs.cjs.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:all": "npm run build && node scripts/build-platforms.js",
    "build:platform": "node scripts/build-platforms.js",
    "build:web": "vite build --config vite.config.web.ts",
    "build:weixin": "vite build --config vite.config.weixin.ts",
    "build:alipay": "vite build --config vite.config.alipay.ts",
    "build:baidu": "vite build --config vite.config.baidu.ts",
    "build:toutiao": "vite build --config vite.config.toutiao.ts",
    "build:nodejs": "vite build --config vite.config.nodejs.ts",
    "dev": "vite",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
