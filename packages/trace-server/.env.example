# ====================== 应用配置 ======================
# Nest 服务端口
PORT=3000
NODE_ENV=development

# ====================== 数据库配置 ======================
# MySQL 连接地址（本地开发使用）
DATABASE_URL="mysql://root:your_password@localhost:3307/traceflow"

# MySQL 容器配置（用于 docker-compose.yml）
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=your_password
MYSQL_DATABASE=traceflow
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# ====================== Redis 配置 ======================
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=

# ====================== AI 配置 ======================
# 通义千问 API Key（必填）
DASHSCOPE_API_KEY=your_dashscope_api_key

# 通义千问 Base URL
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# AI 模型名称（默认 qwen-turbo，可选 qwen-plus、qwen-max）
AI_MODEL_NAME=qwen-turbo

# AI 缓存 TTL（秒），默认 600 秒（10分钟）
AI_CACHE_TTL=600

# JWT 密钥
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN_DAYS=7