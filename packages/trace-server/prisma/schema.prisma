generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TraceEventType {
  track
  page
  error
  identify
  custom
}

enum TracePriority {
  critical
  normal
  low
}

model TraceEvent {
  id          BigInt         @id @default(autoincrement())
  eventId     String         @unique @map("event_id") @db.VarChar(255)
  eventType   TraceEventType @map("event_type")
  eventName   String?        @map("event_name") @db.VarChar(255)
  timestamp   BigInt
  userId      String?        @map("user_id") @db.VarChar(64)
  anonymousId String         @map("anonymous_id") @db.VarChar(255)
  sessionId   String         @map("session_id") @db.VarChar(255)
  url         String?        @db.VarChar(500)
  title       String?        @db.VarChar(255)
  referrer    String?        @db.VarChar(500)
  deviceInfo  Json           @map("device_info")
  properties  Json?
  priority    TracePriority  @default(normal)
  sent        Boolean        @map("_sent") @default(true)
  retryCount  Int            @map("_retry_count") @default(0)
  createdAt   BigInt         @map("_created_at")

  @@index([timestamp], map: "idx_timestamp")
  @@index([userId], map: "idx_user_id")
  @@index([anonymousId], map: "idx_anonymous_id")
  @@index([sessionId], map: "idx_session_id")
  @@index([eventType], map: "idx_event_type")
  @@index([priority], map: "idx_priority")
  @@map("trace_events")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  roleName    String   @unique @map("role_name") @db.VarChar(50)
  permissions Json
  description String?  @db.VarChar(200)
  createTime  DateTime @default(now()) @map("create_time") @db.Timestamp(3)
  users       User[]

  @@map("role")
}

model User {
  id           BigInt    @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  name         String?   @db.VarChar(50)
  phone        String?   @db.VarChar(20)
  status       Int       @default(1) @db.SmallInt
  roleId       BigInt    @map("role_id")
  createTime   DateTime  @default(now()) @map("create_time") @db.Timestamp(3)
  updateTime   DateTime  @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  projects     Project[]
  role         Role      @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@map("user")
}

model Project {
  id          BigInt   @id @default(autoincrement())
  projectName String   @map("project_name") @db.VarChar(100)
  appId       String   @unique @map("app_id") @db.VarChar(64)
  projectKey  String   @unique @map("project_key") @db.VarChar(255)
  config      Json?
  status      Int      @default(1) @db.SmallInt
  creatorId   BigInt   @map("creator_id")
  createTime  DateTime @default(now()) @map("create_time") @db.Timestamp(3)
  updateTime  DateTime @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  creator     User     @relation(fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([status])
  @@map("project")
}

model BuriedPointData {
  id         BigInt    @db.UnsignedBigInt
  msgId      String?   @map("msg_id") @db.VarChar(64)
  projectId  BigInt    @map("project_id") @db.UnsignedBigInt
  deviceId   String    @map("device_id") @db.VarChar(128)
  userId     String?   @map("user_id") @db.VarChar(64)
  eventTime  BigInt    @map("event_time") @db.UnsignedBigInt
  eventType  EventType @map("event_type")
  platform   String    @db.VarChar(20)
  userAgent  String?   @map("user_agent") @db.Text
  ip         String?   @db.VarChar(45)
  os         String?   @db.VarChar(50)
  browser    String?   @db.VarChar(50)
  country    String?   @db.VarChar(50)
  province   String?   @db.VarChar(50)
  city       String?   @db.VarChar(50)
  data       Json
  isAbnormal Int       @default(0) @map("is_abnormal") @db.TinyInt
  vErrorType String?   @map("v_error_type") @db.VarChar(100)
  vPageUrl   String?   @map("v_page_url") @db.VarChar(500)
  createTime DateTime  @default(now()) @map("create_time")

  @@id([id, eventTime])
  @@index([deviceId, eventTime], map: "idx_device_time")
  @@index([eventType, eventTime], map: "idx_event_type_time")
  @@index([projectId, eventTime], map: "idx_project_event_time")
  @@index([vErrorType], map: "idx_v_error_type")
  @@index([vPageUrl], map: "idx_v_page_url")
  @@map("buried_point_data")
  @@ignore
}

model AbnormalData {
  id           BigInt   @id @default(autoincrement())
  projectId    BigInt   @map("project_id")
  originalData String   @map("original_data") @db.Text
  errorReason  String   @map("error_reason") @db.VarChar(500)
  createTime   DateTime @default(now()) @map("create_time") @db.Timestamp(3)

  @@index([projectId, createTime])
  @@map("abnormal_data")
}

model Statistics {
  id               BigInt          @id @default(autoincrement())
  projectId        BigInt          @map("project_id")
  eventType        EventType       @map("event_type")
  statTime         DateTime        @map("stat_time") @db.Timestamp(3)
  timeGranularity  TimeGranularity @map("time_granularity")
  pv               BigInt          @default(0)
  uv               BigInt          @default(0)
  errorCount       BigInt          @default(0) @map("error_count")
  performanceIndex Json?           @map("performance_index")
  createTime       DateTime        @default(now()) @map("create_time") @db.Timestamp(3)

  @@unique([projectId, eventType, statTime, timeGranularity])
  @@map("statistics")
}

model AiAnalysisResult {
  id           BigInt   @id @default(autoincrement())
  projectId    BigInt   @map("project_id")
  analysisType String   @map("analysis_type") @db.VarChar(50)
  analysisData Json     @map("analysis_data")
  sqlLog       String?  @map("sql_log") @db.Text
  createTime   DateTime @default(now()) @map("create_time") @db.Timestamp(3)

  @@index([projectId, analysisType, createTime])
  @@map("ai_analysis_result")
}

model AlarmRule {
  id         BigInt   @id @default(autoincrement())
  projectId  BigInt   @map("project_id")
  ruleName   String   @map("rule_name") @db.VarChar(100)
  alarmType  String   @map("alarm_type") @db.VarChar(50)
  threshold  Json
  receivers  Json
  status     Int      @default(1) @db.SmallInt
  createTime DateTime @default(now()) @map("create_time") @db.Timestamp(3)
  updateTime DateTime @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)

  @@index([projectId, status])
  @@map("alarm_rule")
}

model AlarmRecord {
  id           BigInt     @id @default(autoincrement())
  ruleId       BigInt     @map("rule_id")
  projectId    BigInt     @map("project_id")
  alarmContent String     @map("alarm_content") @db.Text
  alarmLevel   AlarmLevel @default(warning) @map("alarm_level")
  status       Int        @default(0) @db.SmallInt
  handleTime   DateTime?  @map("handle_time") @db.Timestamp(3)
  createTime   DateTime   @default(now()) @map("create_time") @db.Timestamp(3)

  @@index([projectId, status])
  @@index([createTime])
  @@map("alarm_record")
}

model SystemLog {
  id            BigInt   @id @default(autoincrement())
  requestId     String   @map("request_id") @db.Char(36)
  apiUrl        String   @map("api_url") @db.VarChar(255)
  method        String   @db.VarChar(10)
  requestParams String?  @map("request_params") @db.Text
  responseData  String?  @map("response_data") @db.Text
  costTime      Int?     @map("cost_time")
  ip            String?  @db.VarChar(45)
  userId        BigInt?  @map("user_id")
  errorMsg      String?  @map("error_msg") @db.Text
  createTime    DateTime @default(now()) @map("create_time") @db.Timestamp(3)

  @@index([requestId])
  @@index([apiUrl, createTime])
  @@map("system_log")
}

model RefreshToken {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  tokenHash    String   @map("token_hash") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at") @db.Timestamp(3)
  ip           String?  @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  revoked      Boolean  @default(false)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamp(3)
  createTime   DateTime @default(now()) @map("create_time") @db.Timestamp(3)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("refresh_token")
}

enum EventType {
  behavior
  performance
  error
}

enum TimeGranularity {
  hour
  day
}

enum AlarmLevel {
  info
  warning
  critical
}
